# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
.DS_Store

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key
kubeconfig
kubeconfig-*
.aws-session

# --- Terraform ---
**/.terraform/*
# .terraform.lock.hcl is deliberately NOT ignored. It is the only thing recording
# the exact provider hashes an apply used; without it, `terraform init` resolves
# `~> 5.70` to whatever shipped this morning and two people plan different
# infrastructure from identical code. The default template ignores it, which is
# the single most commonly inherited Terraform mistake.
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# ...except the one the CI risk commenter needs. It is stored outside both
# Terraform roots and copied in by scripts/tf-plan-mock.sh, which removes it on
# a trap. The blanket ignore above is right -- an override inside a root would
# point a real apply at a mock endpoint -- so this is a deliberate, narrow hole.
!infra/terraform/ci/mock_override.tf
.terraformrc
terraform.rc
*.tfvars
*.tfvars.json
!example.tfvars
!sandbox.tfvars.example

# --- Gradle / Java ---
.gradle/
build/
!src/**/build/
out/
bin/
!**/src/**/bin/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- Node / frontend ---
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-report/
test-results/

# --- Build / test output ---
*.log
.cache/
tmp/
reports/
*.sbom.json
trivy-results.*

# --- Helm ---
charts/**/charts/
charts/**/Chart.lock
*.tgz

# --- Rendered diagram output (sources are .mmd) ---
docs/diagrams/*.svg
docs/diagrams/*.png

# Lock files belong to root modules only. A lock file inside a reusable module is
# never consulted -- the root's constraints win -- so committing one just creates
# a second copy to forget to update.
infra/terraform/modules/*/.terraform.lock.hcl
