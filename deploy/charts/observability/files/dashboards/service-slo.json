{
  "uid": "starling-slo",
  "title": "Service SLOs",
  "tags": ["starling", "slo"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_requests_seconds_count, app)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability, last hour",
      "description": "1 minus the 5xx ratio. The SLO is 99.5%; the thresholds are set at the SLO and at one burn rate above it, so the colour changes when the budget starts moving rather than when the service is already down.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.928 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sli:errors:ratio_rate1h{app=~\"$app\"}",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by outcome",
      "description": "Split by status class rather than totalled. A flat total with 2xx falling and 5xx rising is the shape of a real incident and is invisible in a single line.",
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{app=~\"$app\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency",
      "description": "p50, p95 and p99 from the histogram, aggregated across pods before the quantile is taken. Averaging per-pod quantiles instead would produce a number that is not a quantile of anything.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error budget burn rate",
      "description": "How fast the 30-day budget is being spent. 1 is exactly on budget; 14.4 exhausts it in two days and is the paging threshold.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sli:errors:ratio_rate1h{app=~\"$app\"} / 0.005",
          "legendFormat": "{{app}} 1h"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Errors and warnings",
      "description": "Filtered to level rather than to a substring, which only works because the services log ECS JSON and promtail parses it. Each line carries trace_id as structured metadata, so a line links straight to its trace.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"starling\", level=~\"ERROR|WARN\"}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
