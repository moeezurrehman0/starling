{
  "uid": "twitterclone-fanout",
  "title": "Fan-out",
  "tags": ["twitter-clone", "fanout"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Stream discovered",
      "description": "Gap register row 18. The worker used to resolve its stream once at start-up and, on failure, run ready and idle forever. This panel is the fleet-wide view of that condition; the readiness probe is the per-pod one.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "RETRYING", "color": "red", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (group, table) (stream_resolved)",
          "legendFormat": "{{group}} / {{table}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fan-out lag",
      "description": "Age of a stream record when fan-out finished with it, from the stream's own timestamp. This is the freshness SLI: the whole path from write to timeline, not just this worker's share of it. The 30s line is the objective.",
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fanout_lag_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fanout_lag_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Records by outcome",
      "description": "Deliberately not one throughput line. An hour of celebrity_skipped and an hour of fanned_out are identical under a single counter and mean opposite things; truncated is a correctness failure hiding inside a throughput graph.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(fanout_records_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Timeline writes and fan-out duration",
      "description": "Writes per second against the p95 time to materialise one tweet. A rising duration with flat writes is DynamoDB throttling; a rising duration with rising writes is simply a popular author.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fanout_timeline_writes_total[5m]))",
          "legendFormat": "timeline writes/s"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fanout_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 fan-out duration"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Fan-out worker log",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"twitter-clone\", app=\"fanout-worker\"}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
