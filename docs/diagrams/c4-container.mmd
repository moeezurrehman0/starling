---
title: C4 Level 2 — Containers
---
graph TB
    user(["<b>User</b><br/><i>[Person]</i>"])

    subgraph cluster["Kubernetes Cluster"]
        web["<b>web</b><br/><i>[Next.js 15]</i><br/>Server-rendered UI"]
        gw["<b>gateway</b><br/><i>[Spring Boot 4]</i><br/>Routing, JWT validation,<br/>rate limiting, API versioning"]
        usr["<b>user-service</b><br/><i>[Spring Boot 4]</i><br/>Accounts, auth, profiles,<br/>follow graph"]
        twt["<b>tweet-service</b><br/><i>[Spring Boot 4]</i><br/>Tweets, likes, replies,<br/>media metadata,<br/>search API + indexer"]
        tl["<b>timeline-service</b><br/><i>[Spring Boot 4]</i><br/>Home timeline reads,<br/>hybrid merge, cache routing"]
        fan["<b>fanout-worker</b><br/><i>[Spring Boot 4]</i><br/>Consumes the tweets stream,<br/>materialises timelines"]
        rcel[("<b>redis-celeb</b><br/><i>[in-cluster / ElastiCache]</i><br/>celebrity profiles + tweets<br/>noeviction, 256Mi")]
        rmain[("<b>redis-main</b><br/><i>[in-cluster / ElastiCache]</i><br/>timeline pages, profiles,<br/>rate limits, allkeys-lru")]
    end

    ddb[("<b>DynamoDB</b><br/>users, handles, tweets, follows,<br/>timelines, likes, idempotency,<br/>stream_checkpoints")]
    stream{{"<b>DynamoDB Streams</b><br/><i>[tweets table]</i><br/>NEW_AND_OLD_IMAGES"}}
    pg[("<b>PostgreSQL</b><br/><i>[RDS / Aurora]</i><br/>schema: search<br/>derived data only")]
    s3[("<b>S3</b><br/>tweet media")]

    user -->|HTTPS| web
    web -->|"REST /api/v1"| gw
    user -.->|"presigned PUT"| s3

    gw -->|REST| usr
    gw -->|REST| twt
    gw -->|REST| tl
    gw -->|"token buckets"| rmain

    usr -->|"users, handles, follows"| ddb
    twt -->|"tweets, likes<br/>TransactWriteItems"| ddb
    twt -->|"presigned URLs"| s3
    twt -->|"full-text queries"| pg

    ddb -->|"change records"| stream
    stream -->|"consumer 1"| fan
    stream -->|"consumer 2 — search indexer"| twt
    twt -.->|"upsert index"| pg

    fan -->|"BatchWriteItem timelines"| ddb
    fan -->|"celebrity set + recent tweets"| rcel

    tl -->|"cached page"| rmain
    tl -->|"celebrity tweets"| rcel
    tl -->|"Query timelines on miss"| ddb

    classDef person fill:#08427b,stroke:#052e56,color:#fff
    classDef container fill:#1168bd,stroke:#0b4884,color:#fff
    classDef store fill:#438dd5,stroke:#2e6295,color:#fff
    class user person
    class web,gw,usr,twt,tl,fan container
    class ddb,stream,pg,s3,rcel,rmain store
